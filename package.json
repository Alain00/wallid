{
  "name": "wallid",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --hot server.ts",
    "build": "bun build.ts",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "migrate": "wrangler d1 migrations apply wallid --remote",
    "migrate:local": "wrangler d1 migrations apply wallid --local",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.3.1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "latest",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "wrangler": "^4"
  }
}
