# Copy to `.dev.vars`. Wrangler reads that file; it is gitignored, and it is not
# an `.env` — these are Worker secrets, and the two should not be one file.
# Everything here is read at request time by the Worker; `.env` is read at
# build time by Bun and compiled into the client bundle. Nothing secret goes
# there.

# Pepper for the identity hashes. Any long random string; changing it orphans
# every existing owner token.
WALL_SECRET="a-development-pepper"

# Cloudflare Turnstile. The values below are Cloudflare's published test pair,
# which accepts any token — a clone with no real keys still gets a working wall.
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"

# Stripe. Test keys from the dashboard; the webhook secret comes out of
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Bearer token for the moderation endpoints.
WALL_ADMIN_TOKEN="development"

# Comma-separated. Not in the repo: a blocklist in a public repo is a word list
# for anyone who wants to find what is not blocked.
WALL_BLOCKLIST=""

# The live visitor count on the wall — the chip that says how many people are
# here. Reading Analytics Engine is an HTTP API rather than a binding, so it
# wants an account token even though writing does not.
#
# `PULSE_READ_TOKEN` is an account token with `Account Analytics: Read`, made at
# https://dash.cloudflare.com/profile/api-tokens. In production it is a Worker
# secret (`bunx wrangler secret put PULSE_READ_TOKEN --env production`) and
# never a var in `wrangler.jsonc`: it can read every Analytics Engine dataset
# on the account, and that file is in the repo.
#
# Both blank is the supported state. `/wall/pulse` then answers `{"here":null}`
# and the chip does not render — which is also what local development looks
# like, since nothing is writing a dataset there anyway.
PULSE_ACCOUNT_ID=""
PULSE_READ_TOKEN=""
